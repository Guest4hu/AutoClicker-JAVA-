<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane stylesheets="@styles.css" styleClass="app-container" prefWidth="560.0" prefHeight="730.0"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.autoclicker.ui.controller.MainController">
    <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="app-tabs">
        <Tab text="AutoClicker">
            <fx:include fx:id="autoClickerTab" source="auto-clicker-tab.fxml" />
        </Tab>
        <Tab text="Macro">
            <fx:include fx:id="macroTab" source="macro-tab.fxml" />
        </Tab>
    </TabPane>
</StackPane>
